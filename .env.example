# Public hostname and Traefik routing
SIDRA_HOSTNAME=sidra-academy.duckdns.org
TRAEFIK_NETWORK=proxy
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Application secrets — generate unique values before starting
NODE_ENV=production
JWT_SECRET=
JWT_REFRESH_SECRET=
SEED_ADMIN_PASSWORD=

# MySQL credentials — use hex values so MYSQL_PASSWORD is URL-safe in DATABASE_URL
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Optional; enables monthly teacher-hours digest emails.
SMTP_URL=
MAIL_FROM=
